<Window x:Class="FWLauncherV2.Dialogs.PaketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Paket"
        Width="620" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Margin="14" CornerRadius="18" Background="{StaticResource WindowBackdrop}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="Header_MouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="+" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBaslik" Text="Yeni Oyun Paketi" Style="{StaticResource H2}" FontSize="17"/>
                        <TextBlock Text="Kaydedince herkes için yayınlanır (yalnızca owner)." Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kimlik (Id, ör. skyblock)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtId" Style="{StaticResource FWTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ad" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtAd" Style="{StaticResource FWTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Paket sürümü" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtSurum" Style="{StaticResource FWTextBox}" Text="1.0.0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Minecraft" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtMc" Style="{StaticResource FWTextBox}" Text="1.20.1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Yükleyici" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbYukleyici" Height="44" SelectedIndex="0">
                                <ComboBoxItem Content="Forge"/>
                                <ComboBoxItem Content="NeoForge"/>
                                <ComboBoxItem Content="Fabric"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Paket zip adresi (CurseForge biçimi: manifest.json + overrides/)" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <TextBox x:Name="TxtZip" Style="{StaticResource FWTextBox}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sunucu adresi" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtIp" Style="{StaticResource FWTextBox}" Text="play.firewing.store"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtPort" Style="{StaticResource FWTextBox}" Text="25565"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Açıklama" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <TextBox x:Name="TxtAciklama" Style="{StaticResource FWTextBox}"/>

                    <TextBlock Text="Kart arka planı" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="150" Height="84" CornerRadius="10" BorderBrush="#33FFB347" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush x:Name="ImgArkaplan" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <Button Content="Görsel seç" Width="140" Height="38" Style="{StaticResource SecondaryButton}" Click="ArkaplanSec_Click"/>
                            <Button Content="Kaldır" Width="140" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="ArkaplanKaldir_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Oyun içi görseller (kartta döngüyle gösterilir)" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                    <WrapPanel x:Name="PnlGorseller"/>
                    <Button Content="+ Görsel ekle" HorizontalAlignment="Left" Width="160" Height="38" Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButton}" Click="GorselEkle_Click"/>
                    <TextBlock x:Name="TxtYukleniyor" Text="Yükleniyor..." Visibility="Collapsed" Margin="0,8,0,0" Style="{StaticResource Caption}"/>

                    <Border x:Name="ErrorBox" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="10" Padding="12,8"
                            Background="#26FF6A00" BorderBrush="#66FF6A00" BorderThickness="1">
                        <TextBlock x:Name="TxtHata" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnSil" Content="Sil" Width="100" Height="44" Margin="0,0,12,0" Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Click="Sil_Click"/>
                <Button Content="Vazgeç" Width="120" Height="44" Margin="0,0,12,0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="BtnKaydet" Content="KAYDET VE YAYINLA" Width="210" Height="44" Style="{StaticResource PrimaryButton}" Click="Kaydet_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
