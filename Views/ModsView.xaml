<UserControl x:Class="FWLauncherV2.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border CornerRadius="30" Background="#C0191817" BorderBrush="#FF272523" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ALT MENÜ -->
            <Border BorderBrush="#FF272523" BorderThickness="0,0,1,0">
                <Grid Margin="22,30,22,24">
                    <StackPanel>
                        <Button x:Name="TabMods" Content="Modlar" Style="{StaticResource SubNavItem}" Tag="active" Click="Tab_Click" CommandParameter="0"/>
                        <Button x:Name="TabShaders" Content="Gölgelendiriciler" Style="{StaticResource SubNavItem}" Click="Tab_Click" CommandParameter="1"/>
                        <Button x:Name="TabPacks" Content="Kaynak Paketleri" Style="{StaticResource SubNavItem}" Click="Tab_Click" CommandParameter="2"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Border x:Name="UserModsOffNote" CornerRadius="12" Background="#2AFBBF24" Padding="12,9" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="Kullanıcı modları Ayarlar'dan kapatılmış; yalnız ana paket yüklenir." TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="#FFFCD06A"/>
                        </Border>
                        <TextBlock Text="Ana paket kilitli, senin eklediklerin ayrı klasörde durur." TextWrapping="Wrap"
                                   FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İÇERİK -->
            <Grid Grid.Column="1" Margin="44,24,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtTitle" Text="Modlar" Style="{StaticResource PixelTitle}"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Açıp kapatabileceğin mod listesi." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <TextBox x:Name="TxtFilter" Width="220" Height="42" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                             Style="{StaticResource FWTextBox}" TextChanged="Filter_TextChanged" ToolTip="Listede ara"/>
                    <StackPanel x:Name="FilterHint" Orientation="Horizontal" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,150,20">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,2,8,0"/>
                        <TextBlock Text="Ara" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
                    <ItemsControl x:Name="RowsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="22" Style="{StaticResource HoverCard}"
                                        Margin="0,0,22,20" Padding="20,16" Height="108">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="72" CornerRadius="14" ClipToBounds="True" Background="#FF151413"
                                                Margin="0,0,22,0" Visibility="{Binding IconVisibility}">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="34" Height="34"
                                                Style="{StaticResource ChromeButton}" Margin="0,0,10,0" Tag="{Binding}" Click="Delete_Click"
                                                Visibility="{Binding DeleteVisibility}" ToolTip="Kaldır"/>
                                        <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanToggle}" Tag="{Binding}" Click="Toggle_Click" VerticalAlignment="Center"
                                                  ToolTip="Aç / kapat"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="TxtEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="15" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="420"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnFromStore" Content="+ Mağazadan Ekle" Height="54" Padding="28,0" Style="{StaticResource PrimaryButton}"
                            Click="FromStore_Click"/>
                    <Button Content="Dosyadan Ekle" Height="54" Margin="16,0,0,0" Style="{StaticResource SecondaryButton}" Click="FromFile_Click"/>
                    <Button Content="&#xE8B7;" Style="{StaticResource IconSquareButton}" Width="54" Height="54" FontSize="17" Margin="16,0,0,0"
                            ToolTip="Klasörü aç" Click="OpenFolder_Click"/>
                    <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="22,0,0,0" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
