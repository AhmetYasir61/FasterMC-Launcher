<UserControl x:Class="FWLauncherV2.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="#FF1D1C1B"/>
            <Setter Property="BorderBrush" Value="#FF2E2C2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource PixelText}">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- PROFİL KARTI -->
                <Border CornerRadius="30" Background="#C01C1B19" BorderBrush="{DynamicResource PageStrokeBrush}" BorderThickness="1.5" Padding="36,32,18,30">
                    <StackPanel>
                        <Grid Margin="0,0,18,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="112" Height="112" CornerRadius="24" Background="{DynamicResource PageGradientD}"
                                    BorderBrush="#33FFFFFF" BorderThickness="2">
                                <Grid>
                                    <TextBlock x:Name="TxtInitial" Text="O" Style="{StaticResource PixelText}" FontSize="48" Foreground="#FF151413"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <Border Margin="8" ClipToBounds="True">
                                        <Border.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Border Width="92" Height="92" CornerRadius="17" Background="Black"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Border.OpacityMask>
                                        <Image x:Name="ImgHead" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <Border Style="{StaticResource PagePill}" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtRank" Text="Oyuncu" Style="{StaticResource PixelText}" FontSize="14"
                                               Foreground="{DynamicResource PageAccentBrush}"/>
                                </Border>
                                <TextBlock x:Name="TxtName" Text="Oyuncu" Style="{StaticResource PixelText}" FontSize="44" Foreground="White"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Bakiyen" HorizontalAlignment="Right" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtCoins" Text="0" Style="{StaticResource PixelText}" FontSize="40" Foreground="#FFFCD34D"
                                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                <TextBlock Text="Coin" HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="Oynama süresi" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtPlayTime" Text="0 dk" Style="{StaticResource StatValue}" Foreground="#FFEACF5E"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="Oyun açılışı" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtLaunches" Text="0" Style="{StaticResource StatValue}" Foreground="#FFFBBF24"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="Son oturum" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtLastSession" Text="—" Style="{StaticResource StatValue}" Foreground="#FFFBAB71"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="İlk giriş" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtFirstSeen" Text="—" Style="{StaticResource StatValue}" Foreground="#FFFDE798"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="Son giriş" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtLastLogin" Text="Bugün" Style="{StaticResource StatValue}" Foreground="#FFFCD95D"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="Bizimle" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtSince" Text="Yeni" Style="{StaticResource StatValue}" Foreground="#FFE6C435"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Rütbe Satın Al" Height="50" Padding="26,0" Style="{StaticResource PrimaryButton}" Click="BuyRank_Click" Margin="0,0,14,0"/>
                            <Button Content="Bakiye Yükle" Height="50" Style="{StaticResource SecondaryButton}" Click="TopUp_Click" Margin="0,0,14,0"/>
                            <Button Content="Coin Gönder" Height="50" Style="{StaticResource SecondaryButton}" Click="Transfer_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- HESAP BİLGİLERİ -->
                <Border CornerRadius="26" Background="#C0191817" BorderBrush="#FF272523" BorderThickness="1" Padding="30,24" Margin="0,24,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Hesap bilgileri" Style="{StaticResource PixelText}" FontSize="20" Foreground="White"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,90,0" LineHeight="22"
                                       Text="Oynama süresi ve giriş bilgileri bu bilgisayarda launcher tarafından tutulur. Öldürülen mob, ölüm gibi oyun içi istatistikler sunucu bağlantısı kurulunca canlı gelecek."/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Cihaz kimliği:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtHwid" Text="" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource PagePill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="YEREL" Style="{StaticResource PixelText}" FontSize="14" Foreground="{DynamicResource PageAccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
