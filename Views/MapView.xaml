<UserControl x:Class="FWLauncherV2.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border CornerRadius="0" BorderBrush="{DynamicResource PageStrokeBrush}" BorderThickness="1.5" ClipToBounds="True">
        <Border.Background>
            <ImageBrush ImageSource="/Assets/Images/lava.jpg" Stretch="UniformToFill"/>
        </Border.Background>
        <Grid>
            <!-- Yer tutucu (harita yokken / açılamazken) -->
            <Border x:Name="Placeholder" CornerRadius="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B35A4C11" Offset="0"/>
                        <GradientStop Color="#99583919" Offset="0.55"/>
                        <GradientStop Color="#B35C3710" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Harita" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPlaceholder" Text="[Sunucu haritası burada gösterilecek]" FontSize="17" HorizontalAlignment="Center"
                               Foreground="#DDFFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPlaceholderSub" Text="" FontSize="13.5" HorizontalAlignment="Center" Margin="0,10,0,0"
                               Foreground="#99FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnRetry" Content="Tekrar dene" Height="42" Style="{StaticResource SecondaryButton}"
                                Click="Retry_Click" Visibility="Collapsed"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Canlı web haritası (BlueMap / Dynmap / squaremap): yalnız haritanın kendisi ve kendi kontrolleri görünür -->
            <Grid x:Name="WebHost" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
