<UserControl x:Class="FWLauncherV2.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border CornerRadius="30" Background="#C0191817" BorderBrush="#FF272523" BorderThickness="1">
        <Grid Margin="44,26,44,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mağaza" Style="{StaticResource PixelTitle}"/>
                    <TextBlock Text="Modrinth ve CurseForge'dan mod ekle." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SrcModrinth" Content="Modrinth" Height="52" MinWidth="150" FontSize="16" Style="{StaticResource ChipButton}"
                            Tag="active" Click="Source_Click" CommandParameter="0"/>
                    <Button x:Name="SrcCurse" Content="CurseForge" Height="52" MinWidth="170" FontSize="16" Margin="14,0,0,0" Style="{StaticResource ChipButton}"
                            Click="Source_Click" CommandParameter="1"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTextBox}" KeyDown="Search_KeyDown" Padding="48,0,18,0"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource PageAccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Modrinth içinde ara..." Foreground="{StaticResource TextMutedBrush}" FontSize="15"
                           VerticalAlignment="Center" Margin="50,0,0,0" IsHitTestVisible="False"/>
                <Button Grid.Column="1" Content="Ara" Width="110" Height="52" Margin="16,0,0,0" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,14,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="KindMod" Content="Modlar" Style="{StaticResource ChipButton}" Tag="active" Click="Kind_Click" CommandParameter="0"/>
                    <Button x:Name="KindShader" Content="Gölgelendiriciler" Style="{StaticResource ChipButton}" Margin="8,0,0,0" Click="Kind_Click" CommandParameter="1"/>
                    <Button x:Name="KindPack" Content="Kaynak Paketleri" Style="{StaticResource ChipButton}" Margin="8,0,0,0" Click="Kind_Click" CommandParameter="2"/>
                </StackPanel>
                <TextBlock x:Name="TxtCompat" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>

            <ScrollViewer x:Name="Scroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultList" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="24" Style="{StaticResource HoverCard}" Margin="0,0,22,22"
                                    Height="320" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="22,22,0,0" Background="{Binding HeaderBrush}">
                                        <Border Width="96" Height="96" CornerRadius="18" ClipToBounds="True" Background="#FF151413"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5"/>
                                            </Border.Effect>
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="22,18,22,18">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                                       TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DownloadsText}" VerticalAlignment="Bottom" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <Button Content="{Binding ButtonText}" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Click="Install_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallPrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Background" Value="#FF201E1D"/>
                                                            <Setter Property="Foreground" Value="#FFDEC24A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="TxtState" Grid.Row="3" Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>

            <!-- Kurulum durumu -->
            <Border x:Name="InstallOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#CC0E0D0D" CornerRadius="20" Margin="-44,-26,-44,-22">
                <Border Style="{StaticResource Card}" Padding="34,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                    <StackPanel>
                        <TextBlock x:Name="TxtInstallTitle" Text="Kuruluyor" Style="{StaticResource PixelText}" FontSize="20" Foreground="White"/>
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,18,0,0" Foreground="{DynamicResource PageGradient}" Background="#FF272523" BorderThickness="0"/>
                        <TextBlock x:Name="TxtInstallStep" Text="" Margin="0,14,0,0" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
