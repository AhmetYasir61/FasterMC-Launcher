<Window x:Class="FWLauncherV2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FasterMC Launcher"
        Width="1212"
        Height="772"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border Margin="16" CornerRadius="0" Background="{StaticResource WindowBackdrop}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Border CornerRadius="0" BorderBrush="#FF262523" BorderThickness="1" ClipToBounds="True">
            <Grid MouseDown="TopBar_MouseDown" Background="Transparent">
                <!-- Anka arka planı (solda), sağa doğru solar -->
                <Image Source="/Assets/Images/phoenix.jpg" Stretch="UniformToFill" HorizontalAlignment="Stretch" Opacity="0.6"
                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Margin="0,70,0,70">
                    <Image.OpacityMask>
                        <RadialGradientBrush Center="0.45,0.5" GradientOrigin="0.45,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#FF000000" Offset="0.3"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="0.6" RadiusY="0.7">
                            <GradientStop Color="#33FF9F3A" Offset="0"/>
                            <GradientStop Color="#00FF9F3A" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- sürüm (sol alt köşe) -->
                <TextBlock x:Name="TxtVersion" Text="FasterMC Launcher · beta" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,16" IsHitTestVisible="False"/>

                <!-- pencere düğmeleri -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0">
                    <Button Content="&#x2012;" FontSize="16" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click"/>
                    <Button Content="&#x2715;" Style="{StaticResource ChromeCloseButton}" Click="CloseButton_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="90,0,30,40" IsHitTestVisible="False">
                        <TextBlock x:Name="TxtHero" Text="Hoş&#x0a;geldin!" Style="{StaticResource PixelTitle}" FontSize="92" LineHeight="128"
                                   LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="TxtHeroSub" Text="Giriş yap ve gerçek hayatta kalma havasına dal." FontSize="22"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="6,26,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- FORM KARTI -->
                    <Border Grid.Column="1" Width="390" Margin="0,70,72,70" VerticalAlignment="Center" CornerRadius="24"
                            Background="#8C0A0908" BorderBrush="#40FFB347" BorderThickness="1.5" Padding="34,32">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,22" HorizontalAlignment="Center">
                                <Image Source="/Assets/Images/logo_full.png" Height="150" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#FFE16F1D" Opacity="0.35"/>
                                    </Image.Effect>
                                </Image>
                            </Grid>

                            <!-- LoginView / RegisterView -->
                            <ContentControl x:Name="ContentArea"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
