<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================ -->
    <!--  POKEWINGLAUNCHER  ·  DRAGON DESIGN SYSTEM                    -->
    <!--  Deep navy base + gold accent + blue/sky/magenta (logo)      -->
    <!-- ============================================================ -->

    <!-- ===================== PALETTE (Colors) ===================== -->
    <!-- Taban: derin lacivert / indigo (logo konturları) -->
    <Color x:Key="C.WindowBg">#FF070707</Color>
    <Color x:Key="C.Sidebar">#B80D0D0D</Color>
    <Color x:Key="C.Surface">#A6141312</Color>
    <Color x:Key="C.SurfaceAlt">#991C1A17</Color>
    <Color x:Key="C.SurfaceHover">#B326221D</Color>
    <Color x:Key="C.Stroke">#40FFB347</Color>
    <Color x:Key="C.StrokeSoft">#26FFB347</Color>

    <Color x:Key="C.TextPrimary">#FFFFF8EC</Color>
    <Color x:Key="C.TextSecondary">#FFC9BCA6</Color>
    <Color x:Key="C.TextMuted">#FF8A7F6E</Color>

    <!-- Accent: altın sarısı (ejderha gövdesi) — anahtar adları korunur -->
    <Color x:Key="C.Accent">#FFFF8C1A</Color>
    <Color x:Key="C.AccentAmber">#FFFFD23F</Color>
    <Color x:Key="C.AccentRed">#FFFF6A00</Color>

    <!-- Logo'nun mavi & magenta renkleri (kanatlar) -->
    <Color x:Key="C.AccentBlue">#FFFFC21A</Color>
    <Color x:Key="C.AccentSky">#FFFFE066</Color>
    <Color x:Key="C.AccentPink">#FFFF9F1C</Color>

    <Color x:Key="C.Success">#FFFFD23F</Color>
    <Color x:Key="C.Warning">#FFFFB020</Color>
    <Color x:Key="C.Danger">#FFFF6A00</Color>
    <Color x:Key="C.Online">#FFFFC21A</Color>

    <!-- ===================== BRUSHES ===================== -->
    <SolidColorBrush x:Key="WindowBgBrush"     Color="{StaticResource C.WindowBg}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"   Color="{StaticResource C.SurfaceAlt}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="StrokeBrush"       Color="{StaticResource C.Stroke}"/>
    <SolidColorBrush x:Key="StrokeSoftBrush"   Color="{StaticResource C.StrokeSoft}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource C.TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource C.TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource C.TextMuted}"/>

    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource C.AccentAmber}"/>
    <SolidColorBrush x:Key="AccentRedBrush"   Color="{StaticResource C.AccentRed}"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="{StaticResource C.Warning}"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="OnlineBrush"      Color="{StaticResource C.Online}"/>

    <!-- Logo mavisi / gök mavisi / magenta fırçaları -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource C.AccentBlue}"/>
    <SolidColorBrush x:Key="AccentSkyBrush"  Color="{StaticResource C.AccentSky}"/>
    <SolidColorBrush x:Key="AccentPinkBrush" Color="{StaticResource C.AccentPink}"/>

    <SolidColorBrush x:Key="AccentSoftBrush"     Color="#2EFF8E3D"/>
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#2EF68A19"/>
    <SolidColorBrush x:Key="AccentPinkSoftBrush" Color="#2EEC8C28"/>

    <!-- Accent gradient (altın: amber → gold) -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.AccentAmber}" Offset="0"/>
        <GradientStop Color="{StaticResource C.AccentRed}"   Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource C.AccentAmber}" Offset="0"/>
        <GradientStop Color="{StaticResource C.AccentRed}"   Offset="1"/>
    </LinearGradientBrush>

    <!-- Logo marka gradyanı: mavi → magenta → altın (hero/aksanlar) -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.AccentBlue}" Offset="0"/>
        <GradientStop Color="{StaticResource C.AccentPink}" Offset="0.55"/>
        <GradientStop Color="{StaticResource C.Accent}"     Offset="1"/>
    </LinearGradientBrush>

    <!-- Window backdrop gradient (lacivert → magenta tonlu lacivert) -->
    <LinearGradientBrush x:Key="WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF10100F" Offset="0"/>
        <GradientStop Color="#FF0E0D0D" Offset="0.55"/>
        <GradientStop Color="#FF1A1917" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <!-- ===================== TYPOGRAPHY ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===================== PRIMARY BUTTON ===================== -->
    <!-- Pikachu: sarı zemin + siyah metin -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource PageGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="14" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                      Color="{DynamicResource PageAccentColor}" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SECONDARY BUTTON ===================== -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== GHOST / LINK BUTTON ===================== -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== WINDOW CHROME BUTTONS ===================== -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== NAV ITEM (Sidebar) ===================== -->
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}" Padding="14,0">
                        <Grid>
                            <Border x:Name="bar" Width="3.5" Height="22" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="{DynamicResource PageGradientD}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TEXTBOX ===================== -->
    <Style x:Key="FWTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FF10100F"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentAmberBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF423F3C"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FWTextBoxReadOnly" TargetType="TextBox" BasedOn="{StaticResource FWTextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- ===================== COMBOBOX (koyu tema — varsayılan) ===================== -->
    <!-- x:Key YOK → tüm ComboBox'lara otomatik uygulanır (beyaz-beyaz okunmazlık düzeltmesi). -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="11" Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1.2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PageAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1.2" CornerRadius="11" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="240">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ib" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7" Margin="4,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ib" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ib" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PASSWORD BOX ===================== -->
    <Style x:Key="FWPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#FF10100F"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentAmberBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF423F3C"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PROGRESS BAR ===================== -->
    <Style x:Key="FWProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource PageGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" ClipToBounds="True">
                        <!-- PART_Track ŞART: WPF, dolum genişliğini PART_Indicator.Width = (Value/Max) * PART_Track.ActualWidth
                             ile hesaplar. PART_Track olmadan indicator genişliği hiç ayarlanmaz ve bar dolmaz. -->
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0"
                                                      Color="{DynamicResource PageAccentColor}" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SLIDER ===================== -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                  Color="{DynamicResource PageAccentColor}" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource PageGradientD}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderBarTransparent" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="6"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderBarFill" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource PageGradient}" Height="6" CornerRadius="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FWSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource SurfaceAltBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderBarFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderBarTransparent}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CHIP (market kategorileri) ===================== -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="15,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource PageGradient}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TILE (hızlı erişim kutucuğu) ===================== -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CARD ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================================ -->
    <!--  AURORA & MERCAN: FireWing tasarım sistemi eklentileri        -->
    <!--  Koyu lacivert-mor zemin. Her sayfa kendi rengini taşır;      -->
    <!--  Page* anahtarları MainWindow tarafından sayfa değişince      -->
    <!--  Application.Resources üzerinden değiştirilir (DynamicResource)-->
    <!-- ============================================================ -->

    <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Minecraftia</FontFamily>
    <FontFamily x:Key="LogoFont">pack://application:,,,/Assets/Fonts/#Minecrafter</FontFamily>

    <!-- Varsayılan sayfa rengi: Oyna (turuncu) -->
    <Color x:Key="PageAccentColor">#FFFF8D3A</Color>
    <Color x:Key="PageAccent2Color">#FFFFAA3B</Color>
    <SolidColorBrush x:Key="PageAccentBrush" Color="#FFFF8E3D"/>
    <SolidColorBrush x:Key="PageSoftBrush" Color="#2EFF8E3D"/>
    <SolidColorBrush x:Key="PageStrokeBrush" Color="#66FF8E3D"/>
    <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF8D3A" Offset="0"/>
        <GradientStop Color="#FFFFAA3B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PageGradientD" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF8D3A" Offset="0"/>
        <GradientStop Color="#FFFFAA3B" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PageGlowBrush" Center="0.85,0.05" GradientOrigin="0.85,0.05" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#33FF8D3A" Offset="0"/>
        <GradientStop Color="#00FF8D3A" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="InputBgBrush" Color="#FF10100F"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF191817"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#FF201F1D"/>
    <SolidColorBrush x:Key="TileBgBrush" Color="#FF22211F"/>

    <!-- ===================== PİKSEL BAŞLIKLAR ===================== -->
    <Style x:Key="PixelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="44"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="White" Opacity="0.22"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minecraftia glifleri satır kutusunun üst kısmında durur (aksanlar için pay bırakır);
         rozet/hap içinde optik olarak ortalanması için hafif aşağı kaydırılır. -->
    <Style x:Key="PixelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="24,8,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="460"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource PixelText}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ===================== ROZET / HAP ===================== -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="#1FFFFFFF"/>
        <Setter Property="Padding" Value="16,7"/>
    </Style>

    <Style x:Key="PagePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource PageSoftBrush}"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>

    <!-- ===================== KENAR RAYI (ikon + etiket) ===================== -->
    <Style x:Key="RailItem" TargetType="Button">
        <Setter Property="Width" Value="72"/>
        <Setter Property="Height" Value="58"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="16" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                        </Border>
                        <Border x:Name="bar" Width="4" Height="44" CornerRadius="2" HorizontalAlignment="Right"
                                Margin="0,0,-12,0" Background="{DynamicResource PageGradientD}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PageSoftBrush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ALT MENÜ (sayfa içi sol liste) ===================== -->
    <Style x:Key="SubNavItem" TargetType="Button">
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="20,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#12FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PageSoftBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ÜST ÇUBUK İKON DÜĞMESİ ===================== -->
    <Style x:Key="IconSquareButton" TargetType="Button">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="#FF1D1C1B"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="#FF2E2C2A" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageStrokeBrush}"/>
                            <Setter TargetName="b" Property="Background" Value="#FF262522"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== BÜYÜK OYNA DÜĞMESİ ===================== -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Height" Value="84"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource LogoFont}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource PageGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="20" Background="{TemplateBinding Background}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.45"
                                              Color="{DynamicResource PageAccentColor}"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== YARDIMCI DÜĞMELER ===================== -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="#FF211F1D"/>
        <Setter Property="BorderBrush" Value="#FF5A3916"/>
        <Setter Property="Foreground" Value="#FFFFBE8F"/>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="#FF201E1D"/>
        <Setter Property="BorderBrush" Value="#FF6B5D1F"/>
        <Setter Property="Foreground" Value="#FFDEC24A"/>
    </Style>

    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinWidth" Value="72"/>
    </Style>

    <!-- Tıklanabilir kart -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Background="{TemplateBinding Background}"
                            BorderBrush="#FF2E2C2A" BorderThickness="1.5">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}"/></Style></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageStrokeBrush}"/>
                            <Setter TargetName="b" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.35" Color="{DynamicResource PageAccentColor}"/>
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         To="-4" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PageAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ANAHTAR (ToggleSwitch) ===================== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="56" Height="30" Background="Transparent">
                        <Border x:Name="track" CornerRadius="15" Background="#FF33312E"/>
                        <Ellipse x:Name="knob" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#FFC5A622"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== İNCE KAYDIRMA ÇUBUĞU (varsayılan) ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Background="#33FFFFFF"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#66FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" Margin="1,2"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" Margin="2,1"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Arama kutusu / koyu giriş -->
    <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource FWTextBox}">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="BorderBrush" Value="#FF272523"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>

    <Style x:Key="DarkPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource FWPasswordBox}">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="BorderBrush" Value="#FF272523"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>

    <!-- Üzerine gelince hafifçe kalkan, sayfa rengiyle parlayan kart (Mod satırları, mağaza kartları) -->
    <Style x:Key="HoverCard" TargetType="Border">
        <Setter Property="Background" Value="#FF201F1D"/>
        <Setter Property="BorderBrush" Value="#FF2E2C2A"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PageStrokeBrush}"/>
                <Setter Property="Background" Value="#FF252422"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="{DynamicResource PageAccentColor}"/>
                    </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-3" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Koyu ipucu kutusu -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F2201F1D"/>
        <Setter Property="Foreground" Value="#FFF5F5EE"/>
        <Setter Property="BorderBrush" Value="#FF33312E"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,7">
                        <ContentPresenter>
                            <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF5F5EE"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="MaxWidth" Value="360"/></Style></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
